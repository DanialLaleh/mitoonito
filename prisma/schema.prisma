model Habit {
  id           String     @id @default(cuid())
  title        String
  description  String?
  frequency    String     @default("daily") // daily, weekly, etc.
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // روابط
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs         HabitLog[] // لاگ‌های انجام این عادت در روزهای مختلف
  areaId       String?
  area         Area?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
}

model HabitLog {
  id        String   @id @default(cuid())
  date      DateTime // تاریخی که عادت در آن انجام شده (می‌تواند گذشته یا امروز باشد)
  createdAt DateTime @default(now())

  // روابط
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date]) // جلوگیری از ثبت تکراری یک عادت در یک روز مشخص
}
