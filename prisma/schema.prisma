model Goal {
  id          String   @id @default(cuid())
  title       String
  description String?
  targetDate  DateTime?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // روابط
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]   // یک هدف می‌تواند شامل چندین تسک باشد
  areaId      String?
  area        Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
}

model Task {
  id          String    @id @default(cuid())
  title       String
  date        DateTime  // تاریخ برنامه ریزی شده
  isCompleted Boolean   @default(false)
  completedAt DateTime? // زمان دقیق تیک خوردن تسک (۲۴ ساعته)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // روابط
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId      String?   // تسک می‌تواند اختیاری به یک هدف متصل باشد
  goal        Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  areaId      String?
  area        Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
}
